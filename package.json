{
  "name": "bera-flix",
  "version": "2.0.0",
  "description": "BERA FLIX - Premium Movie Streaming Platform with Real Download Functionality",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "production": "NODE_ENV=production node server.js",
    "cluster": "node cluster.js",
    "test": "node test-api.js",
    "lint": "eslint server.js",
    "setup": "npm install && node setup.js",
    "health": "curl http://localhost:3000/health",
    "benchmark": "node benchmark.js"
  },
  "keywords": [
    "movie",
    "streaming",
    "download",
    "api",
    "entertainment",
    "video",
    "tv-shows",
    "series",
    "bera-flix"
  ],
  "author": "BERA FLIX Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/bera-flix.git"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "rate-limiter-flexible": "^4.0.1",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "optionalDependencies": {
    "sharp": "^0.32.6"
  },
  "files": [
    "server.js",
    "package.json",
    "README.md",
    "public/",
    "config/",
    "middleware/"
  ],
  "config": {
    "port": 3000,
    "api_timeout": 15000,
    "download_timeout": 30000,
    "cache_duration": 600000
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/your-username/bera-flix/issues"
  },
  "homepage": "https://github.com/your-username/bera-flix#readme",
  "funding": {
    "type": "individual",
    "url": "https://paypal.me/beraflix"
  }
}
